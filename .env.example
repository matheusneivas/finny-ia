# Copie para .env e ajuste. Variáveis EXPO_PUBLIC_* ficam VISÍVEIS no app:
# nunca coloque chaves de IA, segredos ou senhas aqui.

# Endereço da Finny API (em produção, obrigatoriamente https://)
# No celular com Expo Go, use o IP do computador na rede local, ex.: http://192.168.0.10:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# true = API de demonstração em memória (só em desenvolvimento), para testar sem backend
EXPO_PUBLIC_API_MOCK=false
